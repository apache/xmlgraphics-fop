<testcase>
  <info>
    <p>
      This test checks that a right to left surrogate pair does not get
      word broken in the middle causing an exception. This is for issue FOP-2918
      java.lang.IllegalArgumentException: ill-formed UTF-16 sequence,
      contains isolated high surrogate at end of sequence.
    </p>
  </info>
  <fo>
    <fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
      <fo:layout-master-set>
        <fo:simple-page-master master-name="TestPage">
          <fo:region-body margin="1cm"/>
        </fo:simple-page-master>
      </fo:layout-master-set>
      <fo:page-sequence master-reference="TestPage">
        <fo:flow flow-name="xsl-region-body">
          <fo:block>
            <fo:block>&#x10826;</fo:block>
          </fo:block>
        </fo:flow>
      </fo:page-sequence>
    </fo:root>
  </fo>
  <checks>
    <eval expected="1" xpath="count(/areaTree/pageSequence)"/>
  </checks>
</testcase>
