<!-- $Id$ -->
<testcase>
  <info>
    <p>
      This test checks that zero minimum dimensions do not collapse the
      viewport of an external graphic.
    </p>
  </info>
  <fo>
    <fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
      <fo:layout-master-set>
        <fo:simple-page-master master-name="normal" page-width="5in" page-height="5in">
          <fo:region-body/>
        </fo:simple-page-master>
      </fo:layout-master-set>
      <fo:page-sequence master-reference="normal">
        <fo:flow flow-name="xsl-region-body">
          <fo:block>
            <fo:external-graphic src="../resources/images/box1.png"
                min-width="0" id="min-width-zero"/>
            <fo:external-graphic src="../resources/images/box1.png"
                inline-progression-dimension.minimum="0pt" id="ipd-minimum-zero"/>
          </fo:block>
          <fo:block>
            <fo:external-graphic src="../resources/images/box1.png"
                min-height="0" id="min-height-zero"/>
            <fo:external-graphic src="../resources/images/box1.png"
                block-progression-dimension.minimum="0pt" id="bpd-minimum-zero"/>
          </fo:block>
        </fo:flow>
      </fo:page-sequence>
    </fo:root>
  </fo>
  <checks>
    <eval expected="40009" xpath="//viewport[@prod-id='min-width-zero']/@ipd"/>
    <eval expected="40009" xpath="//viewport[@prod-id='ipd-minimum-zero']/@ipd"/>
    <eval expected="40009" xpath="//viewport[@prod-id='min-height-zero']/@bpd"/>
    <eval expected="40009" xpath="//viewport[@prod-id='bpd-minimum-zero']/@bpd"/>
  </checks>
</testcase>
